// Publicação na Cloudflare (Workers com arquivos estáticos).
// O site é a pasta site/, entregue direto da rede da Cloudflare, sem custo por
// requisição. O único código no servidor é worker/index.js, que só roda na
// sugestão de cidade (/api/onde), nas páginas das cidades (/nome-uf, como
// /alfenas-mg, e o endereço antigo /cidade/...), nas dos parlamentares
// (/parlamentar/...) e no sitemap.xml e robots.txt.
// Os cabeçalhos de segurança dos arquivos ficam em site/_headers.
// A publicação é feita pelo build da Cloudflare a cada envio ao GitHub. No
// painel (Configurações > Compilações > Compilar caminhos de inspeção), só
// site/*, worker/* e wrangler.jsonc disparam build, desde 18/11/2026: envio
// que muda só dados-fonte/, scripts/, supabase/ ou as tarefas do GitHub não
// gasta minutos de build. Envio com 20 commits ou 3.000 arquivos ou mais
// sempre faz build (regra da Cloudflare).
{
  "name": "arrecadometro-brasil",
  "compatibility_date": "2026-11-13",
  // Endereço público em workers.dev da conta.
  "workers_dev": true,
  // Sem endereços extras de prévia para cada versão publicada.
  "preview_urls": false,
  // Só para os endereços abaixo (ver o começo de worker/index.js); os
  // arquivos de site/ continuam sendo entregues sem passar pelo código.
  "main": "worker/index.js",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // Páginas das cidades: todo endereço que termina em hífen e sigla de
    // estado. Nenhum arquivo de site/ termina assim.
    "run_worker_first": [
      "/api/*", "/cidade/*", "/parlamentar/*", "/sitemap.xml", "/robots.txt",
      "/*-ac", "/*-al", "/*-ap", "/*-am", "/*-ba", "/*-ce", "/*-df", "/*-es", "/*-go",
      "/*-ma", "/*-mt", "/*-ms", "/*-mg", "/*-pa", "/*-pb", "/*-pr", "/*-pe", "/*-pi",
      "/*-rj", "/*-rn", "/*-rs", "/*-ro", "/*-rr", "/*-sc", "/*-sp", "/*-se", "/*-to"
    ]
  }
}
